# Database Configuration
POSTGRES_USER=apirentuser
POSTGRES_PASSWORD=apirentpass
POSTGRES_DB=apirental
DATABASE_URL=postgresql://apirentuser:apirentpass@localhost:5432/apirental

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Admin Credentials
ADMIN_EMAIL=admin@apirental.com
ADMIN_PASSWORD=admin123

# API Provider Keys (comma-separated for key pools)
OPENAI_API_KEYS=sk-openai-key-1,sk-openai-key-2,sk-openai-key-3
GEMINI_API_KEYS=gemini-key-1,gemini-key-2,gemini-key-3
ANTHROPIC_API_KEYS=sk-ant-key-1,sk-ant-key-2,sk-ant-key-3

# Cashfree Payment Gateway
# Get credentials from: https://merchant.cashfree.com/merchants/developers
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_ENVIRONMENT=sandbox

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
ADMIN_NOTIFICATION_EMAIL=your-gmail@gmail.com

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# Public URLs (used in emails and payment redirects)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Email: smtp (default) or gmail_api (use on hosts that block SMTP, e.g. Render)
EMAIL_TRANSPORT=smtp
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_SENDER=

# Sign-in
GOOGLE_CLIENT_ID=
REQUIRE_EMAIL_OTP=true

# Spending Alerts
SPENDING_ALERT_THRESHOLD_USD=5.00
SPENDING_ALERT_WINDOW_MINUTES=10

# Cost Protection
COST_PROTECTION_THRESHOLD=0.90

# Application
APP_NAME=AI API Rental SaaS
APP_VERSION=1.0.0
ENVIRONMENT=development
